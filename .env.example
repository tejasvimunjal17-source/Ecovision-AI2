# EcoVision AI — local development only
# On Streamlit Community Cloud, put these in Settings → Secrets instead.

OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_VISION_MODEL=openrouter/free
OPENROUTER_SITE_URL=https://ecovision-ai.streamlit.app
OPENROUTER_APP_NAME=EcoVision AI

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=ecovision-media

# Optional first-admin bootstrap. Do NOT commit real values.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisToAStrongPassword123
ADMIN_FIRST_NAME=EcoVision
ADMIN_LAST_NAME=Administrator

APP_SECRET_KEY=change_this_to_a_long_random_string
SESSION_TIMEOUT_MINUTES=60

MUNICIPALITY_NAME=Municipal Corporation of Gurugram (MCG)
SUPPORT_EMAIL=support@ecovision-ai.example.in
SUPPORT_PHONE=+91-9999999999
